{
  "title": "Pod health",
  "uid": "pod-health",
  "tags": ["kubernetes", "pod"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Pods not ready",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{condition=\"true\"} == 0)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Container restarts (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total[15m])) by (namespace, pod)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pods pending",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pods by phase",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase) by (phase)"
        }
      ]
    }
  ]
}
